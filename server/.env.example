# ===============================================================
# EnglishFlow LMS Backend - Environment Variables Example
# ===============================================================

PORT=5000
NODE_ENV=development

# Client URLs (CORS Security)
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000
APP_URL=http://localhost:5173

# Database Connection
# SQLite (Local Development):
# DATABASE_URL="file:./dev.db"
# PostgreSQL (Production / Cloud):
DATABASE_URL="postgresql://postgres:password@localhost:5432/englishflow?schema=public"
DIRECT_URL="postgresql://postgres:password@localhost:5432/englishflow?schema=public"

# Authentication Secrets (Generate secure keys in production)
JWT_ACCESS_SECRET=englishflow_access_secret_key_vietnam_edtech_2026
JWT_REFRESH_SECRET=englishflow_refresh_secret_key_vietnam_edtech_2026
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Payment Transaction HMAC Secret
PAYMENT_HASH_SECRET=englishflow_payment_hash_secret_2026

# Rate Limiting & Anti-DDoS
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=15

# AI Engine Configuration
# Set to 'false' in production when GEMINI_API_KEY is configured
AI_MOCK_MODE=true
AI_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# SMTP Email Service (Optional: fallback to Ethereal dev sandbox if not set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
